OPENAI_API_TOKEN=

CLIENT_ID=ai-service
CLIENT_SECRET=
DB_SERVICE_URL=http://database-service:8000/v1
DB_SERVICE_BASE_URL=http://database-service:8000/v1
# Host root, not under /v1
JWKS_URL=http://database-service:8000/.well-known/jwks.json
# Same values as database-service / hh-service (HR sends X-Internal-Token)
INTERNAL_PROXY_SECRET=
DB_CLIENT_SECRET=

# Same AMQP URL as database-service / hr-worker / message-service.
RABBITMQ_URL=amqp://USER:PASS@HOST:5672/
RABBITMQ_QUEUE_CANDIDATE_EVALUATE_REQUEST=hr.candidate.evaluate.requested
RABBITMQ_QUEUE_CANDIDATE_EVALUATE_RESULT=hr.candidate.evaluate.completed
AI_EVALUATE_CONSUMER_ENABLED=true
# Production: Postgres, not default sqlite (ephemeral in the pod).
# AI_DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST:5432/ai_outbox

# Outbound proxy for OpenAI (same as opened-monitor-bot / bot-service → singbox).
# Default when enabled + empty URL: http://singbox-proxy.infrastructure.svc.cluster.local:8080
TELEGRAM_PROXY_ENABLED=true
TELEGRAM_PROXY_TYPE=http
TELEGRAM_PROXY_URL=
# Legacy alias: TELEGRAM_PROXY=
# Local without singbox: TELEGRAM_PROXY_ENABLED=false
