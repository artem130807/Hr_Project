#TOKENS
# Generate: openssl genrsa -out private.pem 2048
# Then paste the PEM content as a single-line string with \n between lines
# REQUIRED in production (hr-app-secret). Without a stable key, access JWTs
# become invalid after every pod restart and force refresh/re-login races.
PRIVATE_KEY=
SUPERUSER_NAME=
SUPERUSER_PASSWORD=
SERVICE_CLIENTS=bot-service:<secret>,hh-service:<secret>,ai-service:<secret>,db-service:<secret>
# Access JWT TTL in minutes (keep short; refresh renews the session)
ACCESS_TOKEN_EXPIRES=30
# Opaque refresh token TTL in minutes (default 14 days)
REFRESH_TOKEN_EXPIRES=20160
# Service-to-service JWT TTL (no refresh flow)
SERVICE_TOKEN_EXPIRES=4320

# ERP sync (legacy create-into-HR-DB — keep false; users are listed live from ERP)
ERP_SYNC_ENABLED=false
ERP_BASE=https://erp.example.com
ERP_USERS_PATH=/api/v2/users/
ERP_BEARER_TOKEN=
# Optional alternative to bearer:
# ERP_API_KEY=
# ERP_API_KEY_HEADER=X-API-Key
ERP_SYNC_INTERVAL_MINUTES=60
ERP_SYNC_STARTUP_DELAY_SECONDS=45
ERP_SYNC_BATCH_SIZE=100
ERP_DEFAULT_ROLE=dev
ERP_ROLE_MAP={"superadmin":"superadmin","Админ":"admin","Менеджер":"manager","Руководитель":"leader","Руководитель отдела":"dept_leader","Старший менеджер":"senior_manager","HR":"hr","Lead":"lead","Owner":"owner","Разработчик":"dev","Dev":"dev","Art":"art"}

# ERP centralized auth (required). Tokens + passwords live in erp-backend.
ERP_AUTH_ENABLED=true
ERP_AUTH_TOKEN_PATH=/auth/token
ERP_AUTH_REFRESH_PATH=/auth/refresh
ERP_AUTH_LOGOUT_PATH=/auth/logout
ERP_AUTH_ME_PATH=/users/me
# Same value as erp-backend env SECRET_JWT (required for login).
ERP_JWT_SECRET=
# aliases also accepted: SECRET_AUTH_JWT, SECRET_JWT

#database-service
POSTGRES_DB=db
POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

DB_CLIENT_ID=db-service
DB_CLIENT_SECRET=

# Private S3-compatible storage for candidate employment documents
S3_ENDPOINT_URL=
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_TTL_SECONDS=900
CANDIDATE_DOCS_TOKEN_TTL_HOURS=168
CANDIDATE_DOCS_DRAFT_TTL_HOURS=72
HIRING_REQUEST_INVITE_TTL_HOURS=168


#bot-service
BOT_TOKEN=
BOT_NAME=
BOT_SERVICE_CLIENT_ID=bot-service
BOT_SERVICE_CLIENT_SECRET=
BOT_SERVICE_INTERNAL=http://bot-service:8002


#service urls
DB_SERVICE_INTERNAL=http://database-service:8000
DB_SERVICE_URL=${DB_SERVICE_INTERNAL}/v1
JWKS_URL=${DB_SERVICE_INTERNAL}/.well-known/jwks.json
# Used by hh-service to persist HH OAuth tokens across restarts
REDIS_SERVICE_URL=redis://redis_db:6379/0


#hh-service
HH_SERVICE_INTERNAL=http://hh-service:8003
HH_SERVICE_CLIENT_ID=hh-service
HH_SERVICE_CLIENT_SECRET=
# Shared secret for database-service → hh-service / ai-service proxy (must match on those services).
# If unset, falls back to HH_SERVICE_CLIENT_SECRET / DB_CLIENT_SECRET.
INTERNAL_PROXY_SECRET=

#HH API
EMPLOYER_ID=
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_EMAIL=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
# Seconds until access token expires when bootstrapping from env (e.g. 1209599)
HH_TOKEN_EXPIRES_IN=
# If true, overwrite Redis tokens with HH_ACCESS_TOKEN / HH_REFRESH_TOKEN on start
HH_FORCE_ENV_TOKENS=false
HH_APP_NAME=HR-Bot
HH_APP_VERSION=1.0
# database-service: optional local OAuth link build (must match hh-service redirect)
# HH_REDIRECT_URI=https://hh.<domain>/v1/hh/auth


#T2 ATS
T2_ATS_BASE=https://ats2.t2.ru/crm/openapi
T2_CALL_SYNC_ENABLED=true
T2_CALL_SYNC_INTERVAL_MINUTES=15
T2_CALL_SYNC_MAX_RECORDS_PER_TICK=300
T2_STT_BACKFILL_ENABLED=true
T2_STT_BACKFILL_INTERVAL_MINUTES=10
T2_STT_BACKFILL_BATCH_SIZE=12
T2_STT_BACKFILL_REQUEST_DELAY_SECONDS=1.0
T2_STT_BACKFILL_MAX_AGE_DAYS=7

# WhisperAi (OpenAI) — HR status + description for CallConversation
# Use the same OPENAI_API_TOKEN as ai-service. Do not commit the key.
OPENAI_API_TOKEN=
CALL_WHISPER_ENABLED=true
CALL_WHISPER_INTERVAL_MINUTES=5
CALL_WHISPER_BATCH_SIZE=6
CALL_WHISPER_REQUEST_DELAY_SECONDS=1.5
CALL_WHISPER_MODEL=gpt-4o-mini

#DEPLOY
API_DOMAIN=
# Public HR frontend origin, also used in adaptation form links.
FRONTEND_URL=
# Optional override when adaptation links use a different public origin.
HR_FRONTEND_BASE_URL=

AI_SERVICE_URL=https://ai.${API_DOMAIN}/v1/

# Candidate AI evaluation via RabbitMQ outbox
# Same broker as message-service / erp-backend. Put in hr-app-secret in k8s.
RABBITMQ_URL=amqp://USER:PASS@HOST:5672/
RABBITMQ_QUEUE_CANDIDATE_EVALUATE_REQUEST=hr.candidate.evaluate.requested
RABBITMQ_QUEUE_CANDIDATE_EVALUATE_RESULT=hr.candidate.evaluate.completed
AI_EVAL_RELAY_ENABLED=true

ENV=DEV
# Включить мок-ответы HH API (по умолчанию выключено). Публикация вакансий идёт на реальный api.hh.ru.
# Установите true ТОЛЬКО для локальной разработки без доступа к HH.
MOCK_HH=false
