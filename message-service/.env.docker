# Env для контейнера message-service.
# Заполните JWT_SECRET, ERP_SERVICE_TOKEN, INTERNAL_SERVICE_TOKEN, RABBITMQ_URL (VPS).

DB_HOST=postgres
DB_PORT=5432
DB_USER=msg
DB_PASS=msg
DB_NAME=message-service
AUTO_MIGRATE=true

HTTP_ADDR=:8080

# Тот же секрет, что SECRET_JWT на VPS erp-backend.
JWT_SECRET=replace-with-vps-SECRET_JWT

# erp-backend на VPS
ERP_BASE_URL=https://backend.alt-cargo.tw1.ru
ERP_SERVICE_TOKEN=change-me
ERP_REQUEST_TIMEOUT=10s

# ERP → POST /api/internal/messages (должен совпадать с MESSAGE_SERVICE_TOKEN ERP)
INTERNAL_SERVICE_TOKEN=change-me

# VPS RabbitMQ (тот же RABBITMQ_URL, что у erp-backend на сервере).
RABBITMQ_URL=amqp://USER:PASS@VPS_RABBITMQ_HOST:5672/
RABBITMQ_QUEUE_ENTITY_CHANGED=message.entity_changed
RABBITMQ_QUEUE_HR_NOTIFY=hr.event.notify
RABBITMQ_CONSUMER_TAG=message-service
RABBITMQ_DURABLE=true
RABBITMQ_PREFETCH=1
RABBITMQ_DIAL_TIMEOUT=10s
WORKER_CONCURRENCY=1
OUTBOX_POLL_INTERVAL=2s

CHANNEL_SYNC_PAGE_SIZE=50
CHANNEL_SYNC_RATE_LIMIT=500ms
CHANNEL_SYNC_INTERVAL=5m

LOG_LEVEL=info
